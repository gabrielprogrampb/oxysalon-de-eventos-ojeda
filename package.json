{
  "name": "oxysalon-de-eventos-ojeda",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "check:env": "node scripts/check-env.mjs",
    "images": "node scripts/localize-images.mjs",
    "capturas": "node scripts/screenshots.mjs",
    "backup": "node scripts/backup-db.mjs",
    "test:e2e": "npm run build:e2e && playwright test",
    "test:e2e:report": "playwright show-report",
    "build:e2e": "vite build --mode test",
    "site:url": "node scripts/set-site-url.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.12.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "playwright-core": "^1.49.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.1.11",
    "vitest": "^3.2.7"
  }
}
