# =============================================================================
# Entorno de PRUEBAS (Playwright)
# =============================================================================
# Vite NO carga `.env.local` cuando el modo es `test`, así que estas variables
# vacías fuerzan el modo demostración aunque tu `.env.local` tenga credenciales
# reales. Las pruebas nunca tocan la base de datos de producción.
# =============================================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
